{
  "$comment": "Modified by Jacobo de Vera, 2026: PR panel integration and configurable stock/custom status bar; see PROVENANCE.md.",
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.16"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tab-strip",
          "type": "row",
          "size": {
            "px": 42
          },
          "resizable": false,
          "children": [
            {
              "id": "pr-toggle",
              "type": "block",
              "size": {
                "px": 76
              },
              "content": {
                "mod": "pr-panel",
                "props": {
                  "mode": "button"
                }
              }
            },
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "tabs"
              },
              "window_drag": true
            }
          ]
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    },
                    {
                      "id": "pull-requests",
                      "type": "block",
                      "content": {
                        "mod": "pr-panel"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status-strip",
          "type": "row",
          "size": {
            "px": 28
          },
          "resizable": false,
          "children": [
            {
              "id": "status-modes",
              "type": "stack",
              "active": "custom-status",
              "children": [
                {
                  "id": "native-status",
                  "type": "block",
                  "content": {
                    "mod": "workspace-status"
                  }
                },
                {
                  "id": "custom-status",
                  "type": "row",
                  "resizable": false,
                  "children": [
                    {
                      "id": "status-bar-host",
                      "type": "block",
                      "content": {
                        "mod": "status-bar",
                        "props": {
                          "bar": "workspace"
                        }
                      }
                    },
                    {
                      "id": "status-source-computer",
                      "type": "block",
                      "size": {
                        "px": 0
                      },
                      "content": {
                        "mod": "status-computer",
                        "props": {
                          "statusBar": {
                            "bar": "workspace",
                            "item": "computer"
                          }
                        }
                      }
                    },
                    {
                      "id": "status-source-branch",
                      "type": "block",
                      "size": {
                        "px": 0
                      },
                      "content": {
                        "mod": "status-branch",
                        "props": {
                          "statusBar": {
                            "bar": "workspace",
                            "item": "branch"
                          }
                        }
                      }
                    },
                    {
                      "id": "status-source-pr",
                      "type": "block",
                      "size": {
                        "px": 0
                      },
                      "content": {
                        "mod": "pr-status-badge",
                        "props": {
                          "statusBar": {
                            "bar": "workspace",
                            "item": "pr"
                          }
                        }
                      }
                    },
                    {
                      "id": "status-source-agents",
                      "type": "block",
                      "size": {
                        "px": 0
                      },
                      "content": {
                        "mod": "status-agents",
                        "props": {
                          "statusBar": {
                            "bar": "workspace",
                            "item": "agents"
                          }
                        }
                      }
                    },
                    {
                      "id": "status-source-commands",
                      "type": "block",
                      "size": {
                        "px": 0
                      },
                      "content": {
                        "mod": "status-commands",
                        "props": {
                          "statusBar": {
                            "bar": "workspace",
                            "item": "commands"
                          }
                        }
                      }
                    }
                  ]
                }
              ]
            },
            {
              "id": "status-switch",
              "type": "block",
              "size": {
                "px": 28
              },
              "content": {
                "mod": "status-bar",
                "props": {
                  "role": "switch"
                }
              }
            }
          ]
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [14, 12],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [12, 16],
  "$comment": "Modified by Jacobo de Vera, 2026: standalone PR status badge and panel with integrated toggle beside stock Herdr bars. Apache-2.0; see PROVENANCE.md."
}
