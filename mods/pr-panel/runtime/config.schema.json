{
  "type": "object",
  "description": "Your changes. A setting left out uses its default.",
  "additionalProperties": false,
  "properties": {
    "refresh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "every": {
          "title": "Refresh",
          "description": "How often a visible panel rereads GitHub.",
          "type": ["string", "integer"],
          "format": "duration",
          "pattern": "^\\s*\\d+(\\.\\d+)?\\s*(ms|s|m|h)\\s*$",
          "default": "60s"
        },
        "search_debounce": {
          "title": "Search delay",
          "description": "How long typing pauses before a search runs.",
          "type": ["string", "integer"],
          "format": "duration",
          "pattern": "^\\s*\\d+(\\.\\d+)?\\s*(ms|s|m|h)\\s*$",
          "default": "450ms"
        }
      }
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page_size": {
          "title": "Page size",
          "description": "How many pull requests load at a time.",
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "x-step": 5,
          "default": 25
        },
        "default": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tab": {
              "title": "First list",
              "description": "Which pull requests the Repo tab shows first, until a saved view exists.",
              "type": "string",
              "enum": ["all", "mine", "involved"],
              "x-labels": {
                "all": "All PRs",
                "mine": "Created",
                "involved": "Involved"
              },
              "default": "all"
            },
            "state": {
              "title": "First state",
              "description": "The Repo tab's first state filter, until a saved view exists.",
              "type": "string",
              "enum": ["open", "draft", "merged", "closed", "all"],
              "x-labels": {
                "open": "Open",
                "draft": "Draft",
                "merged": "Merged",
                "closed": "Closed",
                "all": "All"
              },
              "default": "open"
            }
          }
        }
      }
    },
    "worktrees": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": {
          "title": "Worktree folder",
          "description": "Where New worktree puts checkouts.",
          "type": "string",
          "default": "~/.herdr/worktrees"
        },
        "open_with": {
          "title": "Open with",
          "description": "What a new worktree opens: terminal, or an installed agent's key such as claude.",
          "type": "string",
          "default": "terminal"
        }
      }
    },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keep_last": {
          "title": "Failure output kept",
          "description": "How much of a failed command's output is kept to show.",
          "type": ["string", "integer"],
          "format": "size",
          "pattern": "^\\s*\\d+(\\.\\d+)?\\s*([Bb]|[Kk][Bb]|[Mm][Bb])\\s*$",
          "default": "60KB"
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "github": {
          "title": "GitHub CLI",
          "description": "The gh command, or its full path.",
          "type": "string",
          "default": "gh"
        }
      }
    },
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Branch PR configuration",
  "$comment": "Modified by Jacobo de Vera, 2026: extracted from the upstream manifest schema for standalone layered settings; see ../PROVENANCE.md."
}
