{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository mod manifest",
  "type": "object",
  "required": ["title", "description", "license", "place"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 240,
      "pattern": "^[^\\r\\n]+$"
    },
    "license": {
      "enum": ["MIT", "Apache-2.0"]
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+"
    },
    "place": {
      "enum": ["none", "left", "right", "top", "bottom"]
    },
    "size": {
      "type": "number",
      "minimum": 0
    },
    "focusable": {
      "type": "boolean"
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["dialog", "popup", "window"]
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "cloned_from": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "install": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?=.*\\S)[^\\u0000]+$"
      },
      "description": "Optional post-install argv, run from the source package directory after approval."
    }
  }
}
