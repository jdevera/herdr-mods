{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository mod metadata",
  "type": "object",
  "required": ["description", "license"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 240,
      "pattern": "^[^\\r\\n]+$"
    },
    "license": {
      "enum": ["MIT", "Apache-2.0"]
    },
    "statusBar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "standalone"],
      "description": "Optional compatibility with this repository's Status Bar API, not a Herdr manifest field.",
      "properties": {
        "api": { "const": 1 },
        "standalone": { "type": "boolean" }
      }
    },
    "install": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?=.*\\S)[^\\u0000]+$"
      },
      "description": "Optional post-install argv, run from the installed package directory after approval."
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "inputs", "outputs", "requires"],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requires": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "dependentRequired": {
    "build": ["install"]
  }
}
