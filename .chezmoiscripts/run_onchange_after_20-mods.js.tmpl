#!/usr/bin/env node
// Platform: {{ .chezmoi.os }}/{{ .chezmoi.arch }}
{{ range $path := glob (joinPath .chezmoi.sourceDir "mods/*/mod.meta.json") -}}
// Metadata: {{ $path | toJson }} {{ include $path | sha256sum }}
{{ $meta := include $path | fromJson -}}
{{ $pkg := dir $path -}}
{{ if hasKey $meta "build" -}}
{{ range $meta.build.inputs -}}
{{ range glob (joinPath $pkg .) -}}
{{ if not (stat .).isDir -}}
// Input: {{ . | toJson }} {{ include . | sha256sum }}
{{ end -}}
{{ end -}}
{{ end -}}
{{ range $meta.build.outputs -}}
// Output: {{ . | toJson }} {{ if stat (joinPath $.chezmoi.destDir "mods" (base $pkg) .) }}present{{ else }}missing {{ uuidv4 }}{{ end }}
{{ end -}}
{{ end -}}
{{ end -}}
// Runner: {{ include "scripts/post-install.ts" | sha256sum }} {{ include "scripts/build-state.ts" | sha256sum }} {{ include "scripts/mod-package.ts" | sha256sum }}
// Approved commands: {{ if hasKey . "herdrModsCommands" }}{{ .herdrModsCommands | toJson }}{{ else }}{}{{ end }}
(async () => {
    const { pathToFileURL } = await import("node:url");
    const { join } = await import("node:path");
    const source = {{ .chezmoi.sourceDir | toJson }};
    const destination = {{ .chezmoi.destDir | toJson }};
    const approved = {{ if hasKey . "herdrModsCommands" }}{{ .herdrModsCommands | toJson }}{{ else }}{}{{ end }};
    const { postInstall } = await import(pathToFileURL(join(source, "scripts/post-install.ts")).href);

    postInstall(source, destination, approved);
})().catch((error) => {
    console.error(error.message);
    process.exitCode = 1;
});
